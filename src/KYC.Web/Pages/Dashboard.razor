@page "/dashboard"
@attribute [Authorize(Policy = "Analyst")]
@implements IAsyncDisposable
@inject IMediator Mediator
@inject KycHubConnectionFactory HubFactory
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-hero mb-4">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Visão operacional de risco, compliance e decisão de crédito corporativo.</p>
    </div>
    <div class="dashboard-actions">
        <a class="btn btn-primary" href="/cases/new">Novo caso</a>
        <a class="btn btn-outline-primary" href="/cases">Ver carteira</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-warning" role="alert">
        <strong>Base de dados indisponível ou erro ao carregar.</strong>
        <p class="mb-0 small">@_loadError</p>
        <p class="mb-0 small mt-2">Confirme que o PostgreSQL está a correr, que a extensão <code>vector</code> existe e execute <code>dotnet ef database update --project src/KYC.Infrastructure --startup-project src/KYC.Web</code> com a connection string correta.</p>
    </div>
}
else if (_summary is not null)
{
    <div class="kpi-grid mb-4">
        <div class="kpi-card kpi-info">
            <span class="kpi-label">Total de casos</span>
            <span class="kpi-value">@_summary.TotalCases</span>
        </div>
        <div class="kpi-card kpi-primary">
            <span class="kpi-label">Casos em curso</span>
            <span class="kpi-value">@_summary.OpenCases</span>
        </div>
        <div class="kpi-card kpi-success">
            <span class="kpi-label">Aprovados hoje</span>
            <span class="kpi-value">@_summary.ApprovedToday</span>
        </div>
        <div class="kpi-card kpi-warning">
            <span class="kpi-label">Em revisão humana</span>
            <span class="kpi-value">@_summary.UnderReview</span>
        </div>
        <div class="kpi-card kpi-neutral">
            <span class="kpi-label">Taxa de aprovação</span>
            <span class="kpi-value">@_summary.ApprovalRatePercent%</span>
        </div>
    </div>
}

<div class="activity-grid mb-4">
    <section class="activity-panel">
        <div class="activity-panel-head">
            <div>
                <h2>Casos recentes</h2>
                <p>Últimos processos abertos na carteira KYC.</p>
            </div>
            <div class="activity-panel-stat">@_recent.Count</div>
        </div>

        @if (_recent.Count == 0)
        {
            <div class="activity-empty">
                <p>Sem casos recentes para mostrar.</p>
                <a class="btn btn-sm btn-outline-primary" href="/cases/new">Criar primeiro caso</a>
            </div>
        }
        else
        {
            <div class="table-responsive activity-table-wrap">
                <table class="table table-hover table-corporate mb-0">
                    <thead>
                    <tr><th>Identificador</th><th>Empresa</th><th>Score</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in _recent.Take(6))
                    {
                        <tr>
                            <td><a class="fw-semibold" href="/cases/@c.Id">@c.Nif</a></td>
                            <td>@c.CompanyName</td>
                            <td><RiskScoreBadge Score="c.Score" /></td>
                            <td><span class="status-pill @StatusClass(c.Status)">@StatusLabel(c.Status)</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <div class="activity-panel-foot">
            <a href="/cases">Ver carteira completa</a>
        </div>
    </section>

    <section class="activity-panel">
        <div class="activity-panel-head">
            <div>
                <h2>Alertas críticos</h2>
                <p>Sinais de risco nas últimas 24 horas.</p>
            </div>
            <div class="activity-panel-stat">@_alerts.Count</div>
        </div>

        @if (_alerts.Count == 0)
        {
            <div class="activity-empty">
                <p>Sem alertas críticos nas últimas 24 horas.</p>
            </div>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var a in _alerts.Take(6))
                {
                    <li>
                        <div>
                            <div class="fw-semibold">@a.CompanyName</div>
                            <div class="text-muted small">@a.SignalSummary</div>
                        </div>
                        <a class="btn btn-sm btn-outline-danger" href="/cases/@a.CaseId">Analisar</a>
                    </li>
                }
            </ul>
        }

        <div class="activity-panel-foot">
            <a href="/cases">Rever casos em aberto</a>
        </div>
    </section>
</div>

<div class="explore-section">
    <div class="section-head">
        <h2>Explorar a plataforma</h2>
        <p>Atalhos para operações, compliance e configuração.</p>
    </div>
    <div class="explore-grid">
        <a class="explore-card" href="/cases/new">
            <span class="explore-tag">Suggested</span>
            <h3>Abrir novo caso</h3>
            <p>Inicie due diligence corporativa com NIF e recolha automática de sinais.</p>
        </a>
        <a class="explore-card" href="/cases">
            <h3>Carteira de casos</h3>
            <p>Filtre, priorize e acompanhe o ciclo de vida de cada processo KYC.</p>
        </a>
        <a class="explore-card" href="/help">
            <h3>Centro de ajuda</h3>
            <p>Guias operacionais e documentação do fluxo KYC.</p>
        </a>
        <AuthorizeView Policy="Admin">
            <Authorized>
                <a class="explore-card" href="/admin/settings">
                    <h3>Configurações</h3>
                    <p>Integrações, LLM e parâmetros operacionais do workspace.</p>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="explore-card" href="/Identity/Account/Manage">
                    <h3>A sua conta</h3>
                    <p>Perfil, segurança e preferências de sessão.</p>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string? _loadError;
    private DashboardSummaryDto? _summary;
    private List<KycCaseDto> _recent = new();
    private List<CriticalAlertDto> _alerts = new();
    private HubConnection? _hub;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        try
        {
            _hub = HubFactory.Create();
            _hub.On<Guid, string>("StatusChanged", async (_, _) => await LoadDataAsync());
            _hub.On<Guid, string>("ReportReady", async (_, _) => await LoadDataAsync());
            await _hub.StartAsync();
        }
        catch
        {
            _refreshTimer = new System.Threading.Timer(async _ => await InvokeAsync(LoadDataAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(60));
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _loadError = null;
            _summary = await Mediator.Send(new GetDashboardSummaryQuery());
            var list = await Mediator.Send(new ListKycCasesQuery(new KycCaseFilter(Page: 1, PageSize: 10)));
            _recent = list.Items.ToList();
            _alerts = (await Mediator.Send(new GetCriticalAlertsQuery())).ToList();
        }
        catch (Exception ex)
        {
            _loadError = ex.InnerException?.Message ?? ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        if (_hub is not null)
            await _hub.DisposeAsync();
    }

    private static string StatusLabel(KycStatus status) => status switch
    {
        KycStatus.Pending => "Pendente",
        KycStatus.InProgress => "Em progresso",
        KycStatus.UnderReview => "Em revisão",
        KycStatus.Approved => "Aprovado",
        KycStatus.Rejected => "Rejeitado",
        _ => status.ToString()
    };

    private static string StatusClass(KycStatus status) => status switch
    {
        KycStatus.Approved => "status-ok",
        KycStatus.Rejected => "status-bad",
        KycStatus.UnderReview => "status-warn",
        _ => "status-neutral"
    };
}
