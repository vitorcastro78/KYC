# Copy to .env before `docker compose up` (optional for local defaults).

# --- Ports ---
KYC_WEB_PORT=8080
POSTGRES_HOST_PORT=5433
RABBITMQ_MGMT_PORT=15672

# --- PostgreSQL ---
POSTGRES_USER=kyc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kyc_dev

# --- RabbitMQ ---
RABBITMQ_USER=kyc
RABBITMQ_PASSWORD=CHANGE_ME

# --- Admin seed ---
KYC_ADMIN_EMAIL=admin@kyc.local
KYC_ADMIN_PASSWORD=ChangeMe@1234

# --- Ollama on the host (Docker Desktop / Linux with host-gateway) ---
OLLAMA_ENDPOINT=http://host.docker.internal:11434
DEFAULT_LLM_MODEL=qwen3.5:9b

# --- ContextMemory gateway (chat/scoring + Global Wiki for reports) ---
CONTEXT_MEMORY_BASE_URL=http://host.docker.internal:5100
CONTEXT_MEMORY_APP_ID=kyc
CONTEXT_MEMORY_API_KEY=cm_kyc_local_key
CONTEXT_MEMORY_USER_ID=kyc-jobs

# --- Optional integrations ---
OPENSANCTIONS_API_KEY=
NEWSAPI_KEY=
IDENTITY_VERIFICATION_BASE_URL=
IDENTITY_VERIFICATION_API_KEY=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
UIF_BASE_URL=
UIF_API_KEY=
BDP_ASSET_FREEZE_BASE_URL=
AZURE_AD_CLIENT_SECRET=

# --- For `dotnet run` against shared Network Postgres or docker-compose.db.yml ---
# KYC_DB_CONNECTION=Host=postgresql.kortexio.io;Port=5432;Database=kyc;Username=kyc;Password=kyc_dev
# KYC_DB_CONNECTION=Host=localhost;Port=5433;Database=kyc_dev;Username=kyc;Password=CHANGE_ME

# --- GHCR tag (docker-compose.ghcr.yml) ---
KYC_TAG=latest
